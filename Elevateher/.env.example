# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/elevateher
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME@localhost:5432/elevateher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ─── Supabase Auth + Storage ────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# ─── Docker Compose Required Vars ────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME

# ─── JWT ───────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret for production!
# For HS256: Use a 256-bit (32+ character) random string
#   Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For RS256: Set JWT_SECRET to the RSA private key PEM (multiline)
# DO NOT use placeholder values in production!
JWT_SECRET=CHANGE_ME_256_BIT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Trusted Proxies ─────────────────────────────────────────
# Comma-separated list of trusted proxy IPs (Cloudflare, ALB, nginx)
# IMPORTANT: Only include IPs of actual reverse proxies you control
# Example: 10.0.0.1,10.0.0.2 for internal ALBs
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ─── AI Models ──────────────────────────────────────────────
# Embedding model — SEA-LION-E5-Embedding-600M (sentence-transformers)
SEA_LION_MODEL_PATH=./models/sea-lion-e5-embedding-600m
# Safety model — when empty (""), CLASSIFIER mode falls back to seeded multilingual
# regex pattern scan (no model network download; survives offline demos).
# Set to a local safetensors / gguf directory to enable full neural safety model.
SAFETY_MODEL_PATH=
# Agent / summarizer model — Phi-3 mini Q4 GGUF via llama-cpp (off-process)
AGENT_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
EMBEDDING_DIM=1024
N_GPU_LAYERS=0

# AI Mode — exposes match / safety / agent runtime tiers on GET /status
# matching_mode = real (embedding model loaded) | fallback (mock vectors + openai-compatible) | mock
# safety_mode   = real (neural model) | classifier-only (regex + threshold) | human-review-only
# agent_mode    = local (llama-cpp) | cloud (Gemini) | deterministic (rule-based)
ENABLE_AI_FEATURES=true
ENABLE_AGENTIC_LAYER=true

# ─── SMS Gateway — Infobip (SE Asia primary) ─────────────────
INFOBIP_API_KEY=CHANGE_ME_INFOBIP_KEY
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER_ID=ElevateHer

# ─── SMS Gateway — Plivo (Indonesia fallback) ────────────────
PLIVO_AUTH_ID=CHANGE_ME
PLIVO_AUTH_TOKEN=CHANGE_ME

# ─── Email ──────────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME_RESEND_KEY
EMAIL_FROM=hello@elevateher.app

# ─── Guardian Consent ────────────────────────────────────────
GUARDIAN_CONSENT_REQUIRED_AGE=18
CONSENT_TOKEN_TTL_HOURS=72

# ─── Security ────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_USSD_PER_MINUTE=30

# ─── Features ───────────────────────────────────────────────
ENABLE_AGENTIC_LAYER=false
ENABLE_QLORA_EMBEDDINGS=false

# ─── Dashboard Service Token ────────────────────────────────
# MUST be a valid JWT (HS256) signed with JWT_SECRET, with claims:
#   sub = "dashboard-service"
#   role = "admin"
#   exp  = some long-lived unix timestamp
# Mint inside the api container:
#   docker exec elevateher_api python -c \
#     "from jose import jwt; \
#      print(jwt.encode({'sub':'dashboard-service','role':'admin','exp':9999999999}, \
#                       '$JWT_SECRET', algorithm='HS256'))"
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_DASHBOARD_JWT

# ─── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
